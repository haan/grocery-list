{
  "cli": {
    "version": "27.5.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "node": "26.12.1",
      "developmentClient": true,
      "distribution": "internal",
      "autoIncrement": true,
      "channel": "development",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "development"
      },
      "environment": "development"
    },
    "production": {
      "node": "26.12.1",
      "distribution": "internal",
      "channel": "production",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "environment": "production",
      "env": {
        "APP_VARIANT": "production"
      }
    }
  }
}
