{
  "expo": {
    "name": "Grocery List Dev",
    "slug": "grocery-list",
    "version": "1.0.12",
    "scheme": "haan-grocerylist-dev",
    "platforms": [
      "android"
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FAFAF7"
      },
      "predictiveBackGestureEnabled": false,
      "package": "io.github.haan.grocerylist.dev",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "owner": "lean-mean-coding-team",
    "plugins": [
      "expo-sqlite",
      "expo-font",
      [
        "expo-camera",
        {
          "recordAudioAndroid": false
        }
      ],
      "./plugins/withGradleJvmArgs",
      "./plugins/withAndroidLocaleConfig",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FAFAF7"
        }
      ],
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "80882728-1f01-40c5-b4aa-56fcfa53f928"
      }
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/80882728-1f01-40c5-b4aa-56fcfa53f928"
    }
  }
}
