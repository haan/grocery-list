{
  "name": "grocery-list",
  "version": "1.0.0",
  "main": "index.ts",
  "engines": {
    "node": "26.x"
  },
  "packageManager": "npm@11.20.0",
  "scripts": {
    "start": "expo start",
    "dev": "expo start --dev-client --lan",
    "dev:tunnel": "expo start --dev-client --tunnel",
    "typecheck": "tsc --noEmit",
    "build:dev": "npx eas-cli@27.5.0 build --platform android --profile development",
    "android": "expo run:android",
    "test": "jest",
    "catalog:build": "node scripts/lod/build.cjs",
    "check:android": "node scripts/check-android.cjs",
    "test:fuzz-harness": "node qa/intent-fuzz/selftest.mjs",
    "language:review": "node scripts/language/review.cjs",
    "language:spellcheck": "node scripts/language/review.cjs --spellcheck",
    "build:production": "npx eas-cli@27.5.0 build --platform android --profile production"
  },
  "dependencies": {
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.2.4",
    "@react-navigation/native-stack": "^7.15.1",
    "expo": "~57.0.32",
    "expo-application": "~57.0.3",
    "expo-camera": "~57.0.6",
    "expo-dev-client": "~57.0.21",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.4",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.3",
    "expo-localization": "~57.0.2",
    "expo-splash-screen": "~57.0.11",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.27",
    "lucide-react-native": "1.16.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-draggable-flatlist": "4.0.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "tweetnacl": "^1.0.3",
    "tweetnacl-util": "^0.15.1",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.86.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.10",
    "@types/react-test-renderer": "^19.1.0",
    "fast-check": "^3.23.0",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.6",
    "sax": "1.6.1",
    "test-renderer": "^1.2.0",
    "typescript": "~6.0.3"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo/android",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg))"
    ],
    "reporters": [
      "default"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/qa/nativeInput.setup.cjs"
    ],
    "testTimeout": 30000
  },
  "overrides": {
    "xcode": {
      "uuid": "^11.1.1"
    },
    "form-data": "^4.0.6",
    "undici": "^6.27.0"
  },
  "expo": {
    "install": {
      "exclude": [
        "@types/jest"
      ]
    }
  }
}
